# Copy to PROJECT ROOT as .env.local (next to package.json). Do not put .env.local inside .next/ — Next.js will not load it.
#
# Local MongoDB (Compass + this app use the same URI):
#   1) Install the server: https://www.mongodb.com/docs/manual/installation/
#      macOS (Homebrew): brew tap mongodb/brew && brew install mongodb-community && brew services start mongodb-community
#   2) If "connection refused" on port 27017, the mongod process is not running — start it first, then open Compass.
#   3) URI examples:
MONGODB_URI=mongodb://127.0.0.1:27017

# Optional — database name (default: flowforge). Collections: newsletter_subscribers, contact_messages
MONGODB_DB=flowforge
#
# Atlas: use mongodb+srv://... from the Atlas UI instead of localhost.
#
# Compass: New Connection → paste MONGODB_URI → connect → database "flowforge" appears after your first form submit.
# First newsletter signup creates a unique index on email (remove duplicate emails first if index creation errors).

# Protect /admin with Basic Auth
ADMIN_USER=admin
ADMIN_PASS=change-me

# Public site URL (metadata, canonical, OG). Optional in development.
# NEXT_PUBLIC_BASE_URL=https://your-domain.com

# "How we work" video — use ONE of these:
#
# A) Self-hosted file: put the video under public/ (e.g. public/videos/video.mp4 — must not be 0 bytes) and set:
# NEXT_PUBLIC_HOW_WE_WORK_VIDEO=/videos/video.mp4
#
# B) Loom embed:
# NEXT_PUBLIC_LOOM_EMBED_URL=https://www.loom.com/embed/your-video-id

# Optional: OpenAI for smart estimate explanations (numbers stay on our US pricing model)
# OPENAI_API_KEY=sk-...
# OPENAI_ESTIMATE_MODEL=gpt-4o-mini
